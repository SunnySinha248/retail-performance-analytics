{
  "name": "Retail Performance Analytics",
  "dataColors": ["#2F6DB5", "#5FA8D3", "#9AA3AD", "#E07B39", "#D64550", "#1B3A5C", "#B8CFE8", "#6B7580"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#2F6DB5",
  "good": "#2F6DB5",
  "neutral": "#9AA3AD",
  "bad": "#D64550",
  "maximum": "#2F6DB5",
  "center": "#F2F2F2",
  "minimum": "#D64550",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "title":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "header":  { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1F2933" },
    "label":   { "fontSize": 9,  "fontFace": "Segoe UI", "color": "#6B7580" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 8, "bottom": 8, "left": 10, "right": 10 }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#F4F6F8" } }, "transparency": 0 }] }
    },
    "lineChart": { "*": { "categoryAxis": [{ "gridlineShow": false }], "valueAxis": [{ "gridlineShow": false }] } },
    "clusteredBarChart": { "*": { "valueAxis": [{ "gridlineShow": false }] } },
    "clusteredColumnChart": { "*": { "valueAxis": [{ "gridlineShow": false }] } }
  }
}
